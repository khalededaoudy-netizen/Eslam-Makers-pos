{
  "name": "makers-pos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build && npm run copy:exe",
    "copy:exe": "powershell -Command \"Copy-Item -Force 'src-tauri/target/release/app.exe' 'src-tauri/target/release/MAKERS POS.exe'; try { Copy-Item -Force 'src-tauri/target/release/MAKERS POS.exe' './MAKERS POS.exe'; Write-Host 'MAKERS POS.exe updated at project root.' } catch { Write-Warning 'Root MAKERS POS.exe is locked (app is running). Close it first, then run: npm run copy:exe' }\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
